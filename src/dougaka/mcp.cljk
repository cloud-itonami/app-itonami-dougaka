(ns dougaka.mcp
  "dougaka の MCP tool 面 — itonami agent（kotoba-lang/itonami-agent）が profile の
  `config.yaml` の `mcp_servers` から stdio で呼ぶ。

  ここにあるのは JSON-RPC の要求 1 件 → 応答 1 件の純関数だけで、stdin/stdout の
  ループは bin/dougaka-mcp が持つ。判定はブラウザと同じ adapter（dougaka.core /
  ingest / export）をそのまま呼ぶ。wasm guest は読まない。guest との一致は
  test/fixtures/parity.edn の表（amu test・wasm parity・kbb の 3 経路）で担保する。

  **pure**: ネットワークも、ファイルの書き込みも、状態の保存もしない。tool は
  渡されたテキストだけから結果を作り、呼び出しをまたいで何も覚えない。

  tool の入力不正は JSON-RPC の error ではなく `isError: true` の結果で返す
  （名前付きの理由を text の `{\"error\": …}` に入れる）。"
  (:require [kotoba.lang.text :as text]
            [dougaka.core :as core]
            [dougaka.ingest :as ingest]
            [dougaka.export :as export]))

(def server-name "dougaka")
(def server-version "0.1.0")
(def default-protocol-version "2024-11-05")

(def max-input-bytes
  "1 回の tool 入力テキストの上限（UTF-8 バイト）。"
  (* 5 1024 1024))

;; ───────── JSON（ホスト） ─────────

(defn ->json [x]
  #?(:cljs (js/JSON.stringify (clj->js x))
     :clj (throw (ex-info "dougaka.mcp needs a JS host for JSON" {}))))

(defn- utf8-length [s]
  #?(:cljs (.-length (.encode (js/TextEncoder.) (str s)))
     :clj (alength (.getBytes ^String (str s) "UTF-8"))))

;; ───────── tool の宣言 ─────────

(def ^:private base-tools
  [{"name" "dougaka_validate"
    "description" (str "Validate a dougaka timeline JSON (scenes/assets/lines): scene count 1..24, "
                       "every scene has a scene frame, estimated duration within 120s. "
                       "Pure: returns named errors, sends and stores nothing.")
    "inputSchema" {"type" "object"
                   "properties" {"text" {"type" "string"
                                         "description" "Timeline JSON text, at most 5 MiB of UTF-8."}}
                   "required" ["text"]
                   "additionalProperties" false}}
   {"name" "dougaka_plan"
    "description" (str "Build a dougaka render plan from timeline JSON: ordered segments with frame/voice/text, "
                       "width/height/fps, bgm, plus display-only ffmpeg argv. "
                       "Pure: no mp4 encoding, no network, nothing stored.")
    "inputSchema" {"type" "object"
                   "properties" {"text" {"type" "string"
                                         "description" "Timeline JSON text, at most 5 MiB of UTF-8."}
                                 "aspect" {"type" "string" "enum" ["portrait" "landscape"]
                                            "description" "Override the timeline aspect. Default follows the timeline (portrait)."}}
                   "required" ["text"]
                   "additionalProperties" false}}])

;; tools / tool-index / handlers は local-tool 定義の後に束ねる（前方参照の禁止）。

;; ───────── 入力の検査 ─────────

(defn- check-args
  "inputSchema の範囲（必須・未知キー・型・enum）だけを見る。
  戻り: nil（通る）か、名前付きの理由文字列。"
  [schema args]
  (let [props (get schema "properties")
        unknown (remove #(contains? props %) (keys args))
        missing (remove #(contains? args %) (get schema "required"))]
    (cond
      (seq unknown) (str "unknown-argument: " (text/join ", " (sort unknown)))
      (seq missing) (str "missing-argument: " (text/join ", " missing))
      :else
      (some (fn [[k v]]
              (let [p (get props k)
                    t (get p "type")]
                (cond
                  (and (= "string" t) (not (string? v))) (str "not-a-string: " k)
                  (and (get p "enum") (not (some #{v} (get p "enum")))) (str "not-allowed: " k)
                  :else nil)))
            args))))

;; ───────── tool の本体 ─────────

(defn- error-result [reason] {:error reason})

(defn validate-timeline
  "dougaka_validate。戻り {:result map} か {:error reason}。"
  [{:strs [text]}]
  (cond
    (> (utf8-length text) max-input-bytes) (error-result "input-too-large: text exceeds 5 MiB")
    (text/blank? text) (error-result "empty-input: text is blank")
    :else
    (let [{:keys [timeline error]} (try (ingest/ingest text)
                                        (catch :default _ {:error "parse-failed"}))]
      (if error
        (error-result error)
        (let [{:keys [ok? errors]} (core/validate timeline)]
          {:result {"ok" ok? "errors" errors}})))))

(defn plan-timeline
  "dougaka_plan。戻り {:result map} か {:error reason}。"
  [{:strs [text aspect]}]
  (cond
    (> (utf8-length text) max-input-bytes) (error-result "input-too-large: text exceeds 5 MiB")
    (text/blank? text) (error-result "empty-input: text is blank")
    :else
    (let [{:keys [timeline error]} (try (ingest/ingest text)
                                        (catch :default _ {:error "parse-failed"}))]
      (if error
        (error-result error)
        (let [{:keys [ok? errors]} (core/validate timeline)]
          (if-not ok?
            {:result {"ok" false "errors" errors "plan" nil}}
            (let [plan (core/build-plan timeline (cond-> {} (seq aspect) (assoc :aspect aspect)))]
              {:result {"ok" true "errors" [] "plan" plan
                        "summary" (export/pretty-plan plan)
                        "ffmpeg" (export/ffmpeg-script plan)}})))))))

;; ───────── browser-local 管理状態の検証 ─────────
;; site/studio-local.js（localstorage 配下、schema itonami.dougaka.v1）と同形の
;; 判定を MCP 側の純関数として持つ。入力は caller が持つ JSON テキストだけで、
;; 送信も保存もしない。tool 名は dougaka_<domain>_validate。

(defn- local-name? [v max] (and (string? v) (<= 1 (count v) max)))
(defn- local-id? [v] (and (string? v) (some? (text/re-matches #"[A-Za-z0-9._-]{1,64}" v))))
(defn- local-job-id? [v] (and (string? v) (some? (text/re-matches #"[A-Za-z0-9_-]{1,128}" v))))
(defn- local-hex-color? [v] (and (string? v) (some? (text/re-matches #"#[0-9a-fA-F]{6}" v))))
(defn- local-sha256? [v] (and (string? v) (some? (text/re-matches #"[0-9a-fA-F]{64}" v))))

(defn- local-settings-errors [settings]
  (cond
    (nil? settings) []
    (not (map? settings)) ["bad-settings"]
    (< 16 (count settings)) ["settings-too-large"]
    :else (if (every? local-id? (keys settings)) [] ["bad-setting-key"])))

(defn- validate-local-project [v]
  (cond
    (not (map? v)) ["bad-project"]
    (not (local-name? (get v "name") 120)) ["missing-name: project.name is 1..120 chars"]
    :else
    (let [jobs (get v "jobs")]
      (cond
        (nil? jobs) (local-settings-errors (get v "settings"))
        (or (not (sequential? jobs)) (< 128 (count jobs)) (not (every? local-job-id? jobs)))
        (conj (local-settings-errors (get v "settings")) "bad-jobs: up to 128 job ids")
        :else (local-settings-errors (get v "settings"))))))

(defn- validate-local-brand-kit [v]
  (cond
    (not (map? v)) ["bad-brand-kit"]
    (not (local-name? (get v "name") 120)) ["missing-name: brand-kit.name is 1..120 chars"]
    :else
    (let [colors (get v "colors")
          fonts (get v "fonts")
          assets (get v "assets")]
      (vec (concat
            (when (and (some? colors)
                       (or (not (sequential? colors)) (< 32 (count colors))
                           (not (every? local-hex-color? colors))))
              ["bad-color: #rrggbb up to 32"])
            (when (and (some? fonts)
                       (or (not (sequential? fonts)) (< 32 (count fonts))
                           (not (every? #(local-name? % 120) fonts))))
              ["bad-font"])
            (when (and (some? assets)
                       (or (not (sequential? assets)) (< 128 (count assets))
                           (not (every? #(and (map? %) (local-name? (get % "label") 120)
                                              (let [h (get % "hash")] (or (nil? h) (local-sha256? h))))
                                        assets))))
              ["bad-assets: up to 128 {label, hash?}"]))))))

(defn- validate-local-canvas [v]
  (cond
    (not (map? v)) ["bad-canvas"]
    :else
    (let [nodes (get v "nodes")
          edges (get v "edges")
          node-ok? (fn [n] (and (map? n) (local-id? (get n "id")) (local-name? (get n "kind") 64)
                                (let [label (get n "label")] (or (nil? label) (local-name? label 120)))))]
      (cond
        (or (not (sequential? nodes)) (< 256 (count nodes)) (not (every? node-ok? nodes)))
        ["bad-nodes: up to 256 {id, kind, label?}"]
        (not= (count nodes) (count (distinct (map #(get % "id") nodes))))
        ["duplicate-node-id"]
        (or (not (sequential? edges)) (< 512 (count edges))
            (not (every? #(and (map? %) (string? (get % "from")) (string? (get % "to"))) edges)))
        ["bad-edges: up to 512 {from, to}"]
        :else
        (let [ids (set (map #(get % "id") nodes))
              bad (filter #(or (not (contains? ids (get % "from"))) (not (contains? ids (get % "to")))) edges)]
          (if (seq bad)
            [(str "dangling-edge: " (get (first bad) "from") " -> " (get (first bad) "to"))]
            []))))))

(defn- validate-local-marketing [v]
  (cond
    (not (map? v)) ["bad-marketing"]
    :else
    (let [title (get v "title")
          copy (get v "copy")
          targets (get v "targets")]
      (vec (concat
            (when (and (some? title) (not (local-name? title 120))) ["bad-title"])
            (when (and (some? copy) (or (not (string? copy)) (< 4000 (count copy)))) ["copy-too-long: 4000 chars"])
            (when (and (some? targets)
                       (or (not (sequential? targets)) (< 32 (count targets))
                           (not (every? #(local-name? % 120) targets))))
              ["bad-targets: up to 32 names"]))))))

(def ^:private local-validators
  {"project" validate-local-project
   "brand-kit" validate-local-brand-kit
   "canvas" validate-local-canvas
   "marketing" validate-local-marketing})

(defn validate-local-shape
  "domain（project/brand-kit/canvas/marketing）と JSON テキスト -> {:result} か {:error}。
  送信も保存もしない純粋検証。"
  [domain {:strs [text]}]
  (cond
    (nil? (get local-validators domain)) (error-result (str "unknown-domain: " domain))
    (> (utf8-length text) max-input-bytes) (error-result "input-too-large: text exceeds 5 MiB")
    (text/blank? text) (error-result "empty-input: text is blank")
    :else
    (let [v (try (ingest/parse-json text) (catch :default _ ::bad-json))]
      (cond
        (= v ::bad-json) (error-result "parse-failed")
        (not (map? v)) (error-result "shape-must-be-a-map")
        :else (let [errors ((get local-validators domain) v)]
                {:result {"ok" (empty? errors) "errors" errors "domain" domain}})))))

(def ^:private local-tool
  (fn [domain]
    {"name" (str "dougaka_" (text/replace domain "-" "") "_validate")
     "description" (str "Validate a dougaka " domain " JSON (browser-local Higgsfield management state). "
                        "Pure: returns named errors, sends and stores nothing.")
     "inputSchema" {"type" "object"
                    "properties" {"text" {"type" "string"
                                          "description" "Management-state JSON text, at most 5 MiB of UTF-8."}}
                    "required" ["text"]
                    "additionalProperties" false}}))

(defn marketing-plan
  "dougaka_marketing_plan。marketing JSON と任意の timeline JSON ->
  配信用の表示計画。送信も保存もしない。"
  [{:strs [text timeline]}]
  (let [checked (validate-local-shape "marketing" {"text" text})]
    (if-let [reason (:error checked)]
      checked
      (let [mres (:result checked)]
        (if-not (get mres "ok")
          {:result mres}
          (if (text/blank? (str timeline))
            {:result {"ok" true "errors" []
                      "share" (export/marketing-share-plan (ingest/parse-json text) nil)}}
            (let [{tl :timeline error :error} (try (ingest/ingest timeline)
                                                   (catch :default _ {:error "parse-failed"}))]
              (if error
                {:result {"ok" false "errors" [error]}}
                (let [{:keys [ok? errors]} (core/validate tl)]
                  (if-not ok?
                    {:result {"ok" false "errors" errors}}
                    {:result {"ok" true "errors" []
                              "share" (export/marketing-share-plan
                                       (ingest/parse-json text)
                                       (core/build-plan tl {}))}}))))))))))

(def ^:private marketing-plan-tool
  {"name" "dougaka_marketing_plan"
   "description" (str "Build a display-only marketing share plan from a marketing JSON "
                      "(title/copy/targets) with an optional timeline JSON attached as a "
                      "render-plan summary. Pure: nothing is sent, published or stored.")
   "inputSchema" {"type" "object"
                  "properties" {"text" {"type" "string"
                                        "description" "Marketing JSON text, at most 5 MiB of UTF-8."}
                                "timeline" {"type" "string"
                                             "description" "Optional timeline JSON text for the attached video plan."}}
                  "required" ["text"]
                  "additionalProperties" false}})

(def tools
  "tools/list が返す tool 宣言。base 2 件に browser-local 管理検証 4 件と配信用表示計画 1 件を束ねる。"
  (conj (into base-tools (map local-tool ["project" "brand-kit" "canvas" "marketing"]))
        marketing-plan-tool))

(def ^:private tool-index (into {} (map (juxt #(get % "name") identity)) tools))

(def ^:private handlers
  {"dougaka_validate" validate-timeline
   "dougaka_plan" plan-timeline
   "dougaka_project_validate" (partial validate-local-shape "project")
   "dougaka_brandkit_validate" (partial validate-local-shape "brand-kit")
   "dougaka_canvas_validate" (partial validate-local-shape "canvas")
   "dougaka_marketing_validate" (partial validate-local-shape "marketing")
   "dougaka_marketing_plan" marketing-plan})

(defn call-tool
  "tool 名と引数（文字列キーの map）→ MCP の tools/call 結果。"
  [tool-name args]
  (let [tool (get tool-index tool-name)
        args (or args {})
        outcome (cond
                  (nil? tool) (error-result (str "unknown-tool: " tool-name))
                  (not (map? args)) (error-result "arguments-not-an-object")
                  :else (or (some-> (check-args (get tool "inputSchema") args) error-result)
                            ((get handlers tool-name) args)))]
    (if-let [reason (:error outcome)]
      {"content" [{"type" "text" "text" (->json {"error" reason})}]
       "isError" true}
      {"content" [{"type" "text" "text" (->json (:result outcome))}]
       "structuredContent" (:result outcome)
       "isError" false})))

;; ───────── JSON-RPC ─────────

(defn- rpc-result [id value] {"jsonrpc" "2.0" "id" id "result" value})
(defn- rpc-error [id code message] {"jsonrpc" "2.0" "id" id "error" {"code" code "message" message}})

(defn handle-request
  "JSON-RPC の要求 map（文字列キー）→ 応答 map。通知（id 無し）には nil。"
  [req]
  (let [id (get req "id")
        method (get req "method")
        params (or (get req "params") {})
        notification? (not (contains? req "id"))]
    (cond
      (not (string? method)) (when-not notification? (rpc-error id -32600 "invalid request: no method"))
      (text/starts-with? method "notifications/") nil
      notification? nil
      (= method "initialize")
      (rpc-result id {"protocolVersion" (or (get params "protocolVersion") default-protocol-version)
                      "capabilities" {"tools" {}}
                      "serverInfo" {"name" server-name "version" server-version}
                      "instructions" (str "dougaka: build an ffmpeg render plan from a timeline JSON you pass in. "
                                          "Pure tools; nothing is encoded, sent or stored.")})
      (= method "ping") (rpc-result id {})
      (= method "tools/list") (rpc-result id {"tools" tools})
      (= method "tools/call") (rpc-result id (call-tool (get params "name") (get params "arguments")))
      :else (rpc-error id -32601 (str "method not found: " method)))))

(defn handle-line
  "stdin の 1 行 → stdout に書く 1 行（改行なし）か nil。"
  [line]
  (when-not (text/blank? line)
    (let [req (ingest/parse-json line)]
      (if (map? req)
        (some-> (handle-request req) ->json)
        (->json (rpc-error nil -32700 "parse error"))))))
