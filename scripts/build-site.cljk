;; ローカルの公開物を組む —— network-awai/cloud-itonami の生成器と同じ契約
;; （site/site.edn）を、共通クロームを被せずに実行する。プレビューと
;; スモークテスト用で、公開の正本は cloud-itonami 側の生成器。
;;
;;   kbb --backend sci \
;;     --classpath "src:site:../../kotoba-lang/text/src:../../kotoba-lang/jp-go-digital-design-system/src:../../kotoba-lang/html/src:../../kotoba-lang/css/src" \
;;     scripts/build-site.cljk [out-dir]
;;
;; 環境変数: KOTOBA_LANG（既定 ../../kotoba-lang）、DDS_CSS（dds.css のパス）。
(ns build-site
  (:require ["fs" :as fs]
            ["path" :as path]
            ["child_process" :as cp]
            ["crypto" :as crypto]
            [clojure.edn :as edn]
            [kotoba.lang.text :as text]
            [dougaka.page]))

(def kotoba-lang (or (aget js/process.env "KOTOBA_LANG") "../../kotoba-lang"))
(def wasm-webcomponent (or (aget js/process.env "KOTOBA_WASM_WEBCOMPONENT")
                           "../../kotoba-lang/wasm-webcomponent"))

(def out-dir (or (first *command-line-args*) "out/site"))

(def site (edn/read-string (fs/readFileSync "site/site.edn" "utf8")))

(defn- copy! [from to]
  (when-not (fs/existsSync from)
    (throw (js/Error. (str "missing source: " from))))
  (fs/mkdirSync (path/dirname to) #js {:recursive true})
  (fs/copyFileSync from to))

(fs/rmSync out-dir #js {:recursive true :force true})

(doseq [f (:vendor site)]
  (copy! (str "site/vendor/" f) (str out-dir "/vendor/" f)))
(doseq [{:keys [repo sha from to]} (:external site)]
  (when-not (and sha (re-matches #"[0-9a-f]{40}" sha))
    (throw (js/Error. (str "missing pinned external revision: " repo))))
  (let [lib (last (text/split repo #"/"))
        target (str out-dir "/" to)
        r (cp/spawnSync "git" #js ["-C" (str kotoba-lang "/" lib) "show" (str sha ":" from)]
                        #js {:maxBuffer (* 8 1024 1024)})]
    (when-not (zero? (.-status r))
      (throw (js/Error. (str "missing pinned external source: " repo " " sha ":" from))))
    (fs/mkdirSync (path/dirname target) #js {:recursive true})
    (fs/writeFileSync target (.-stdout r))))
(doseq [{:keys [from to]} (:sources site)]
  (copy! from (str out-dir "/" to)))
(doseq [{:keys [from to]} (:modules site)]
  (copy! from (str out-dir "/" to)))

(doseq [{:keys [from to sha256]} (get-in site [:client-runtime :files])]
  (let [sha (get-in site [:client-runtime :sha])
        r (cp/spawnSync "git" #js ["-C" wasm-webcomponent "show" (str sha ":" from)]
                        #js {:maxBuffer (* 8 1024 1024)})]
    (when-not (zero? (.-status r))
      (throw (js/Error. (str "missing pinned client runtime source: " sha ":" from))))
    (let [body (.-stdout r)
          got (.digest (.update (crypto/createHash "sha256") body) "hex")]
      (when-not (= got sha256)
        (throw (js/Error. (str "client runtime digest mismatch: " from))))
      (fs/mkdirSync (path/dirname (str out-dir "/" to)) #js {:recursive true})
      (fs/writeFileSync (str out-dir "/" to) body))))

(def dds-css
  (fs/readFileSync (or (aget js/process.env "DDS_CSS")
                       (str kotoba-lang "/jp-go-digital-design-system/resources/jp_go_dds/dds.css"))
                   "utf8"))

(def document (resolve (symbol (str (get-in site [:page :ns])) (str (get-in site [:page :fn])))))

(def html
  (document {:css dds-css
             :vendor-scripts (mapv #(str "vendor/" %) (:vendor site))
             :scittle-scripts (mapv :to (concat (:external site) (:sources site)))}))

;; 外部リクエストゼロ: src / href はすべて相対でなければならない。
(let [refs (map second (text/re-seq #"(?:src|href)=\"([^\"]*)\"" html))
      bad (remove #(text/starts-with? % "./") refs)]
  (when (seq bad)
    (throw (js/Error. (str "external or absolute reference: " (pr-str bad))))))

(fs/writeFileSync (str out-dir "/index.html") (str html "\n"))
(println (str "wrote " out-dir "/index.html (" (count html) " chars) + "
              (count (:vendor site)) " vendor + " (+ (count (:external site)) (count (:sources site)))
              " scittle sources"))
