;; dougaka 動画組み立て dapp — aiueos アプリ記述子（形は dandori の
;; aiueos/dandori.edn に準拠）。
;; 実装の正本: dougaka_core.cljk / docs/aiueos-dapp.md。
;;
;; 判断コア guest（:effects #{}）を指す。imports は無し —— aspect/dims と
;; scene 数・尺・shot の gate は計算だけで、I/O（取り込み・保存・同期）は
;; この外の層が持つ。
;; aiueos session/grant への配線は未実装（docs/aiueos-dapp.md の未実装境界）。
{:aiueos/component :app/dougaka
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "dougaka_core.cljk"
 :aiueos/wasm "dougaka_core.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/aspect-code
                   :app/dims-w
                   :app/dims-h
                   :app/scene-count-ok?
                   :app/duration-ok?
                   :app/shot-ok?
                   :app/empty-score}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
