{:paths ["src"]
 ;; 依存は kotoba.lang.text だけ。値モデル・取り込み・書き出し・画面は .cljk の
 ;; 純関数で、同じファイルが kbb（テスト）とブラウザ（scittle）の両方で走る。
 :deps {;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}}
 :aliases
 {;; site/dougaka/page.cljk（SSR の殻）は DADS と kotoba-lang/html を引くので
  ;; ライブラリの :paths から外す。west レイアウトの local/root。
  :site {:extra-paths ["site"]
         :extra-deps {io.github.kotoba-lang/jp-go-dds
                      {:local/root "../../kotoba-lang/jp-go-digital-design-system"}}}
  :test {:extra-paths ["test"]}}}
