{
  "name": "magatama-dgk4k7x2",
  "main": "src/app.cljc",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "directory": "./svelte/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "dougaka",
    "APP_CAPABILITIES": "[\"edge-assets\",\"bpmn-dispatch\"]",
    "APP_DESCRIPTION": "Edge facade + internal /_d1 endpoint for Dougaka, a UI-less video-render backend generation actor (invoked pod-to-pod by lg-shinshi). Render log persists to Cloudflare D1 (ai-gftd-dougaka); mp4 to B2.",
    "APP_DISPLAY_NAME": "Dougaka",
    "APP_FRAMEWORK": "ts-native",
    "APP_NANOID": "dgk4k7x2",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  // database_id: fill after `wrangler d1 create ai-gftd-dougaka`.
  "d1_databases": [
    { "binding": "DOUGAKA_DB", "database_name": "ai-gftd-dougaka", "database_id": "0059f74b-1f0a-4899-ba59-b2ebbe2be254" }
  ],
  "secrets_store_secrets": [
    { "binding": "DISPATCHER_INTERNAL_SECRET", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "dispatcher_internal_secret" }
  ],
  "routes": [
    { "pattern": "dgk4k7x2.gftd.ai/*", "zone_name": "gftd.ai" },
    { "pattern": "dougaka.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
