{
  "name": "magatama-dgk4k7x2",
  "main": "src/app.cljc",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "directory": "./svelte/build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "dougaka",
    "APP_CAPABILITIES": "[\"edge-assets\",\"bpmn-dispatch\"]",
    "APP_DESCRIPTION": "Dougaka is a UI-less video-render backend generation actor invoked pod-to-pod by lg-shinshi. Production artifacts persist in the kotobase.net content-addressed archive.",
    "APP_DISPLAY_NAME": "Dougaka",
    "APP_FRAMEWORK": "ts-native",
    "APP_NANOID": "dgk4k7x2",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview"
  },
  "secrets_store_secrets": [
    { "binding": "DISPATCHER_INTERNAL_SECRET", "store_id": "1824561668fe47cc9127d493961885af", "secret_name": "dispatcher_internal_secret" }
  ],
  // gftd.ai is being pruned (root ADR-2608312300 D3: no new gftd names, and the
  // route below was DEAD — dougaka.gftd.ai answered 000 on 2026-09-01, no DNS
  // and nothing deployed, and this worker's own `main` points at a src/app.cljc
  // that does not exist. Renaming a dead route is not the guarded case that ADR
  // warns about; renaming a live cookie name, secret binding or serving host is,
  // and none of those are here.
  "routes": [
    { "pattern": "dougaka.itonami.cloud/*", "zone_name": "itonami.cloud" }
  ]
}
