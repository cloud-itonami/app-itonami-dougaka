{:paths ["src" "resources"]

 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.error"}
        ;; kotoba replaced JVM interop here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; douga craft lib (ADR-2607023000) — the timeline→ffmpeg render-plan
        ;; pure functions split out of this repo's old dougaka.ffmpeg-plan.
        ;; Now kotoba lib/kotoba.douga (JUN-649).
        io.github.kotoba-lang/douga
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "64ba9e2e6459e7244ca52945b7b010489d07a008"
         :deps/root "lib/kotoba.douga"}
        ;; keyframe generation (ADR-2607071500) — the shared ComfyUI gateway
        ;; (config-map instance pattern, ADR-2607011900 correction); its JVM
        ;; branch uses the http-kit/jsonista this deps.edn already declares.
        io.github.kotoba-lang/comfyui
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "38654600c00caea2caec9ec0650625f2f6a69378"
         :deps/root "lib/kotoba.comfyui"}
        ;; shared murakumo generation client (ADR-2607299960 follow-up) — the
        ;; API's real host, geometry/frame ranges, artifact-URL rebasing,
        ;; digest verification and cold-start retry live there so every -ka
        ;; repo gets them instead of relearning each one from a 400.
        io.github.kotoba-lang/murakumo-generation
        {:git/url "https://github.com/kotoba-lang/murakumo-generation"
         :git/sha "ce6e673ac7317befdcef767d1e9da3754bc28ba4"}
        http-kit/http-kit   {:mvn/version "2.8.0"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        ring/ring-core      {:mvn/version "1.12.2"}
        metosin/jsonista    {:mvn/version "0.3.11"}}

 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/douga
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.douga"}
    io.github.kotoba-lang/comfyui
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.comfyui"}}}

  :run
  {:main-opts ["-m" "dougaka.server"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner"]}}}
