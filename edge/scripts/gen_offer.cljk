#!/usr/bin/env kbb
;; edge/src/dougaka/offer.cljs を **生成する**。手で書かない。
;;
;;   kbb --backend sci edge/scripts/gen_offer.cljk --pricing <path to actor pricing.edn>
;;   kbb --backend sci edge/scripts/gen_offer.cljk --pricing <path> --check
;;
;; ## なぜ生成するのか
;;
;; 価格の正本は actor repo の `pricing.edn` 1 か所（ADR-2608110200 決定 3）。
;; discovery document に数字を手で写すと、写した側だけが古くなる日が来る ——
;; ADR-2608039990 が記録している事故そのもの（x402.nexus が murakumo の
;; 掲示していない価格を広告し続けた）。
;;
;; ここは repo をまたぐので、依存にはできない。だから vendored copy と同じ
;; 規律にする: 生成物を commit し、**どの sha から生成したかを header に書き**、
;; `--check` で古くなっていることを検出できるようにする。

(ns gen-offer
  (:require [clojure.edn :as edn] [clojure.string :as str]
            ["fs" :as fs] ["child_process" :as cp]))

(def argv (vec (drop 2 (.-argv js/process))))
(defn opt [n d] (let [i (.indexOf argv n)] (if (neg? i) d (get argv (inc i) d))))
(def check? (some #{"--check"} argv))
(def pricing-path (opt "--pricing" "../ai-gftd-dougaka-actor/pricing.edn"))
(def out-path (opt "--out" "edge/src/dougaka/offer.cljs"))

(defn- source-sha []
  (try (str/trim (.toString (cp/execSync "git rev-parse HEAD"
                                         #js {:cwd (.dirname (js/require "path") pricing-path)})))
       (catch :default _ "unknown")))

(defn- request-shaped-plans
  "x402 v1 は request を proxy して応答を待つ。job 形の plan をここに載せると、
   買い手が払ってから『レンダリングは別경로です』と知ることになる。
   `:plan/request-shaped? true` を持つものだけを document に出す。

   そして `:plan/served? true` も要る。**serve していないものを広告しない** ——
   murakumo は 2026-07-31 に広告した path を answer できず、買い手が払って
   検証も通ってから upstream が無いと返した。値段が付いていることと、
   origin が答えられることは別である。"
  [book]
  (filter #(and (:plan/request-shaped? %) (:plan/served? %)) (:pricing/plans book)))

(defn document [book sha]
  (let [plans (request-shaped-plans book)]
    {:x402Version 1
     :seller "dougaka"
     :resources
     (vec (for [p plans]
            {:path "/xrpc/cloud.itonami.apps.dougaka.render"
             :method "POST"
             :x402Version 1
             :price {:usd (str (:plan/usd p))
                     :asset "USDC"
                     :network (:plan/settles-on p)
                     :payTo (:pricing/pay-to book)}
             :description (:plan/name p)}))
     :facilitator "https://x402.nexus"
     :catalog "https://x402.nexus/catalog"
     ;; 買い手が払う前に読めるところに置く。licence がレビュー前であることは
     ;; 隠さない —— 隠して売るのが、この gate が防ごうとしていることである。
     :licence {:status (name (:licence/status book :proposed))
               :document "licence.edn (cloud-itonami/ai-gftd-dougaka-actor)"
               :note "the plan returns ffmpeg commands, not generated frames"}
     :generated {:from "cloud-itonami/ai-gftd-dougaka-actor pricing.edn"
                 :sha sha}}))

(defn- json-escape [s]
  (-> (str s) (str/replace "\\" "\\\\") (str/replace "\"" "\\\"")))

(defn render-kotoba
  "The offer as a `.kotoba` guest returning one JSON string.

   Kotoba rather than ClojureScript, per owner instruction 2026-09-01 —— the
   cljs route needs shadow-cljs, shadow-cljs needs a JVM, and on this machine
   that build waited 40 minutes behind other sessions' `kbb -M:test` under
   load 628. `amu compile --target wasm32-browser` is JVM-free: proven by
   putting failing stubs for java/javac/clojure/clj on PATH and watching the
   compile still exit 0 with a .wasm.

   `main` is exported and takes zero arguments because the browser host
   requires exactly that (`Kotoba browser module must export a main function`,
   `main must take zero arguments` — both measured against the real host and
   the real compiler, not read from a doc)."
  [doc sha]
  (str ";; GENERATED by edge/scripts/gen_offer.cljk — DO NOT EDIT.\n"
       ";; source: cloud-itonami/ai-gftd-dougaka-actor pricing.edn @ " sha "\n"
       ";;\n"
       ";; 価格の正本は 1 か所（ADR-2608110200 決定 3）。手で写すと写した側だけが\n"
       ";; 古くなる —— ADR-2608039990 の事故。再生成:\n"
       ";;   kbb --backend sci edge/scripts/gen_offer.cljk --pricing <path> --kotoba\n"
       ";;\n"
       ";; compile（JVM を起こさない）:\n"
       ";;   amu compile edge/kotoba/offer.kotoba --unpinned \\\n"
       ";;     --target wasm32-browser --output edge/js/offer.wasm\n"
       "(ns offer (:export [main document]))\n\n"
       "(defn main [] :i64 0)\n\n"
       "(defn document [] :string\n  \"" (json-escape (js/JSON.stringify (clj->js doc))) "\")\n"))

(defn- render [doc sha]
  (str ";; GENERATED by edge/scripts/gen_offer.cljk — DO NOT EDIT.\n"
       ";; source: cloud-itonami/ai-gftd-dougaka-actor pricing.edn @ " sha "\n"
       ";;\n"
       ";; 価格の正本は 1 か所（ADR-2608110200 決定 3）。ここへ手で写すと、\n"
       ";; 写した側だけが古くなる —— ADR-2608039990 が記録している事故。\n"
       ";; 再生成: kbb --backend sci edge/scripts/gen_offer.cljk --pricing <path>\n"
       "(ns dougaka.offer)\n\n"
       "(defn document []\n  " (pr-str doc) ")\n"))

(let [raw (try (fs/readFileSync pricing-path "utf8") (catch :default _ nil))]
  (if-not raw
    (do (println "REFUSED: cannot read" pricing-path
                 "— a document generated from a price book nobody read would be a price nobody set")
        (js/process.exit 2))
    (let [book (edn/read-string raw)
          sha (source-sha)
          doc (document book sha)
          text (render doc sha)]
      (when (some #{"--kotoba"} argv)
        (fs/mkdirSync "edge/kotoba" #js {:recursive true})
        (fs/writeFileSync "edge/kotoba/offer.kotoba" (render-kotoba doc sha))
        (println "wrote edge/kotoba/offer.kotoba"))
      (if check?
        (let [cur (try (fs/readFileSync out-path "utf8") (catch :default _ ""))]
          ;; sha 行以外を比べる: sha だけの差は「価格が動いた」ではない
          (let [strip #(str/replace % #";; source:.*\n" "")]
            (if (= (strip cur) (strip text))
              (println "offer.cljs is current")
              (do (println "STALE:" out-path "does not match" pricing-path)
                  (js/process.exit 1)))))
        (do (fs/writeFileSync out-path text)
            (println "wrote" out-path "from" pricing-path "@" sha))))))
