{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {;; Git coordinates rather than :local/root so a pristine clone can build.
  ;; `npm run deploy` builds first, and a build that cannot resolve what it
  ;; needs must fail before anything ships.
  :cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                org.clojure/clojurescript {:mvn/version "1.11.132"}
                io.github.kotoba-lang/douga
                {:git/url "https://github.com/kotoba-lang/douga"
                 :git/sha "5a1e9ac15a4c370da12c3f8aad75021e8535c8fe"}}}}}
