{:itonami.blueprint/id "app-itonami-dougaka"
 :itonami.blueprint/name "dougaka — timeline to ffmpeg render plan, browser-local"
 :itonami.blueprint/domain :media/video-assembly
 :itonami.blueprint/license "AGPL-3.0-or-later"
 :itonami.blueprint/social-impact [:data-sovereignty :self-hosting :creator-tools]
 :itonami.blueprint/robotics false
 :itonami.blueprint/required-technologies [:wasm-guest :browser-local-state]
