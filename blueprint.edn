 ;; fleet catalog が callable だと嘘をつく。
 :itonami.blueprint/org "app"
 :itonami.blueprint/compat
 {:target "ai-gftd-dougaka render graph"
  :scope :data-format
  :network false
  :formats [:dougaka-timeline-json :ffmpeg-render-plan-json]
