 :itonami.blueprint/implementation
 {:language :kotoba
  :target :wasm32-browser-kotoba-v1
  :guest "aiueos/dougaka_core.cljk"
  :descriptor "aiueos/dougaka.edn"
  :ui :scittle-re-frame-reagent
  :capabilities []}}
